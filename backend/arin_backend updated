from fastapi import FastAPI, HTTPException
from pydantic import BaseModel
import mysql.connector
from mysql.connector import Error
from datetime import datetime

app = FastAPI(title="Smart Attendance System API")

# --- CBSE MySQL DATABASE CONFIGURATION ---
DB_CONFIG = {
    "host": "localhost",
    "user": "root",
    "password": "your_mysql_password",  # Replace with your MySQL password
    "database": "school_db"
}

def get_db_connection():
    """Helper function to create a database connection."""
    try:
        connection = mysql.connector.connect(**DB_CONFIG)
        return connection
    except Error as e:
        print(f"Database Error: {e}")
        return None

# --- REQUEST MODEL ---
class AttendanceRecord(BaseModel):
    student_id: str
    student_name: str
    status: str = "PRESENT"

# --- ROUTES ---

@app.get("/")
def home():
    return {"message": "Smart Attendance System Backend is running!"}

@app.get("/students")
def get_students():
    """Fetch all registered students from MySQL."""
    conn = get_db_connection()
    if not conn:
        raise HTTPException(status_code=500, detail="Database connection failed")
    
    cursor = conn.cursor(dictionary=True)
    cursor.execute("SELECT student_id, student_name FROM attendance GROUP BY student_id, student_name")
    students = cursor.fetchall()
    
    cursor.close()
    conn.close()
    return {"students": students}

@app.post("/attendance")
def mark_attendance(record: AttendanceRecord):
    """Log an attendance record while preventing duplicate entries for today."""
    conn = get_db_connection()
    if not conn:
        raise HTTPException(status_code=500, detail="Database connection failed")
    
    today = datetime.now().strftime("%Y-%m-%d")
    now_time = datetime.now().strftime("%H:%M:%S")

    try:
        cursor = conn.cursor()
        query = """
            INSERT INTO attendance (student_id, student_name, date, time, status)
            VALUES (%s, %s, %s, %s, %s)
        """
        cursor.execute(query, (record.student_id, record.student_name, today, now_time, record.status))
        conn.commit()
        
        cursor.close()
        conn.close()
        
        return {
            "status": "success",
            "message": f"Attendance recorded for {record.student_name}",
            "student_id": record.student_id,
            "date": today,
            "time": now_time
        }
    except mysql.connector.IntegrityError:
        cursor.close()
        conn.close()
        # Duplicate prevented gracefully
        return {
            "status": "ignored",
            "message": f"Attendance already recorded for {record.student_name} today."
        }

@app.get("/attendance")
def get_attendance():
    """Fetch all attendance records for dashboard display."""
    conn = get_db_connection()
    if not conn:
        raise HTTPException(status_code=500, detail="Database connection failed")
    
    cursor = conn.cursor(dictionary=True)
    cursor.execute("SELECT attendance_id, student_id, student_name, date, time, status FROM attendance ORDER BY date DESC, time DESC")
    records = cursor.fetchall()
    
    cursor.close()
    conn.close()
    return {"attendance": records}
